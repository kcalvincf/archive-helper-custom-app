{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Archive Helper — remove inbound links (result, batched)",
  "description": "Paste into Contentful App Action 'resultSchema' (JSON Schema draft-04).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "targetEntryId": { "type": "string", "minLength": 1 },
    "totalLinkedEntries": { "type": "integer", "minimum": 0 },
    "batchSizeUsed": { "type": "integer", "minimum": 0 },
    "skipUsed": { "type": "integer", "minimum": 0 },
    "processedInThisBatch": { "type": "integer", "minimum": 0 },
    "nextSkip": { "type": "integer", "minimum": 0 },
    "hasMore": { "type": "boolean" },
    "remainingEstimate": { "type": "integer", "minimum": 0 },
    "changed": { "type": "integer", "minimum": 0 },
    "unchanged": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entryId": { "type": "string", "minLength": 1 },
          "contentTypeId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["changed", "would-change", "unchanged", "failed"]
          },
          "removedCount": { "type": "integer", "minimum": 0 },
          "message": { "type": "string" }
        },
        "required": ["entryId", "status", "removedCount"]
      }
    }
  },
  "required": [
    "targetEntryId",
    "totalLinkedEntries",
    "batchSizeUsed",
    "skipUsed",
    "processedInThisBatch",
    "nextSkip",
    "hasMore",
    "remainingEstimate",
    "changed",
    "unchanged",
    "failed",
    "results"
  ]
}
