# Local dev only (Vite). When the app runs inside Contentful, sdk.ids.app supplies the app definition ID.
# You usually only need the App Action ID here.

# Required for Preview / Remove batch unless you set instance parameters on the Entry sidebar location:
# Contentful → Apps → [your app] → App actions → open "remove incoming links (batched)" → copy the Action ID.
VITE_CONTENTFUL_APP_ACTION_REMOVE_LINKS_ID=

# Optional: same for "get incoming links count" App Action. If unset, the sidebar uses CMA links_to_entry + total.
# VITE_CONTENTFUL_APP_ACTION_GET_INCOMING_LINKS_COUNT_ID=

# Optional default batch size for unlink in the sidebar (integer 1–100).
# VITE_DEFAULT_UNLINK_BATCH_SIZE=20

# Optional override if sdk.ids.app is unavailable (rare):
# VITE_CONTENTFUL_APP_DEFINITION_ID=

# Optional: set to "true" to republish previously published entries after Remove links (local dev).
# Default when unset: draft-only updates (same as instance parameter republishAfterUnlink off).
# VITE_CONTENTFUL_REPUBLISH_AFTER_UNLINK=

